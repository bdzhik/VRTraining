  m_Script: {fileID: 11500000, guid: dcba66a9a53b4e6498cc0bd579d72498, type: 3}
  m_Name: ConveyorScenario
  m_EditorClassIdentifier: Assembly-CSharp::VRTraining.Scenario.Definitions.ScenarioDefinition
  scenarioId: conveyor-maintenance
  title: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043A\u043E\u043D\u0432\u0435\u0439\u0435\u0440\u0430
    \u043A \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044E"
  groups:
  - id: preparation
    title: "\u0414\u043E\u043F\u0443\u0441\u043A \u043A \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044E"
    instruction: "1. \u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A
      \u0441\u0442\u0435\u043D\u0434\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\n2.
      \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u0430\u0441\u043A\u0443.\n3.
      \u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436\u0430."
    steps:
    - id: preparation.approach-stand
      description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A
        \u0441\u0442\u0435\u043D\u0434\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
      expectedActions:
      - actionType: 0
        targetId: zone.briefing
    - id: preparation.take-helmet
      description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u0437\u0430\u0449\u0438\u0442\u043D\u0443\u044E
        \u043A\u0430\u0441\u043A\u0443"
      expectedActions:
      - actionType: 1
        targetId: ppe.helmet
    - id: preparation.confirm
      description: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435
        \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0430\u0436\u0430"
      expectedActions:
      - actionType: 3
        targetId: ui.briefing-confirm
  - id: shutdown
    title: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
    instruction: "1. \u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A
      \u043F\u0430\u043D\u0435\u043B\u0438.\n2. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043A\u043D\u043E\u043F\u043A\u0443 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438.\n3.
      \u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043F\u0438\u0442\u0430\u043D\u0438\u0435."
    steps:
    - id: shutdown.approach-panel
      description: "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A
        \u043F\u0430\u043D\u0435\u043B\u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
      expectedActions:
      - actionType: 0
        targetId: zone.control-panel
    - id: shutdown.stop
      description: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435
        \u043A\u043E\u043D\u0432\u0435\u0439\u0435\u0440"
      expectedActions:
      - actionType: 2
        targetId: conveyor.stop-button
    - id: shutdown.power-off
      description: "\u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043F\u0438\u0442\u0430\u043D\u0438\u0435"
      expectedActions:
      - actionType: 2
        targetId: conveyor.power-switch
  - id: lockout
    title: "\u0411\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0430 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0433\u043E
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430"
    instruction: "1. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
      \u0434\u043E\u043F\u0443\u0441\u043A\u0430.\n2. \u0412\u0441\u0442\u0430\u0432\u044C\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443 \u0432 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u0435\u043B\u044C.\n3.
      \u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438."
    steps:
    - id: lockout.take-card
      description: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
        \u0434\u043E\u043F\u0443\u0441\u043A\u0430"
      expectedActions:
      - actionType: 1
        targetId: ppe.safety-card
    - id: lockout.insert-card
      description: "\u0412\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
        \u0432 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u0435\u043B\u044C"
      expectedActions:
      - actionType: 4
        targetId: conveyor.card-socket
    - id: lockout.complete
      description: "\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435
        \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438"
      expectedActions:
      - actionType: 3
        targetId: ui.training-complete
